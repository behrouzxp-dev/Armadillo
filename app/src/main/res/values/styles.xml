<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      A single static light theme: no values-night variant exists and night mode
      is explicitly disabled, so the system setting cannot change the app look.
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/design_primary</item>
        <item name="android:statusBarColor">@color/design_canvas</item>
        <item name="android:navigationBarColor">@color/design_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/design_canvas</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
